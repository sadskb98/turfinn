# ── Turfinn local secrets ─────────────────────────────────────────────────────
# Copy to .env and fill in real values.
# docker-compose reads this file and consul-init pushes everything to Consul KV.
# The api/worker containers only receive CONSUL_URL + CONSUL_TOKEN — all other
# config is fetched from Consul at startup.
#
# Consul UI (local):  http://localhost:8500
# Consul token:       turfinn-local-root-token
# ─────────────────────────────────────────────────────────────────────────────

# JWT — change before going to production
JWT_SECRET=change-me-in-production

# Postgres password (default matches docker-compose postgres service)
DB_PASSWORD=turfinn

# MinIO credentials (default matches docker-compose minio service)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# SSLCommerz sandbox (get from merchants.sslcommerz.com)
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWD=
SSLCZ_BASE_URL=https://sandbox.sslcommerz.com

# Public URL the API is reachable at (used for SSLCommerz callbacks)
APP_BASE_URL=http://localhost:8080

# Firebase — paste the full service account JSON on ONE line
# (Firebase Console → Project Settings → Service accounts → Generate new key)
FIREBASE_SERVICE_ACCOUNT_JSON=

# SMS — SSL Wireless (sslwireless.com → Merchant Portal)
SMS_API_USER=
SMS_API_PASS=
SMS_SID=

# CORS — comma-separated list of allowed origins for production
# Leave empty for local dev (defaults to localhost:3000/3002/3003)
CORS_ORIGINS=
