# ── Local dev without Docker ──────────────────────────────────────────────────
# When running `go run ./cmd/api` directly (no Docker), the app falls back to
# this file if Consul is not reachable.
#
# With Docker Compose, all these values live in Consul KV (prefix: turfinn/).
# The api/worker containers only need:
#   CONSUL_URL=http://consul:8500
#   CONSUL_TOKEN=turfinn-local-root-token
#   CONSUL_PREFIX=turfinn
# ─────────────────────────────────────────────────────────────────────────────

APP_PORT=8080
APP_BASE_URL=http://localhost:8080

DB_HOST=localhost
DB_USER=turfinn
DB_PASSWORD=turfinn
DB_NAME=turfinn
DB_PORT=5432

REDIS_ADDR=localhost:6379
ASYNQ_REDIS_ADDR=localhost:6379

JWT_SECRET=change-me-in-production

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false

SSLCZ_STORE_ID=your_store_id
SSLCZ_STORE_PASSWD=your_store_passwd
SSLCZ_BASE_URL=https://sandbox.sslcommerz.com

# Paste full service account JSON on one line
FIREBASE_SERVICE_ACCOUNT_JSON=
